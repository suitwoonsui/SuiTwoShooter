{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static",
      "config": {
        "ignore": [
          "wallet-module/src/**",
          "wallet-module/node_modules/**",
          "wallet-module/package.json",
          "wallet-module/vite.config.js"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "ignore": [
    "wallet-module/src/**",
    "wallet-module/node_modules/**",
    "wallet-module/package.json",
    "wallet-module/vite.config.js",
    "backend/**"
  ]
}

