{
  "name": "suitwo-shooter-game-backend",
  "version": "1.0.0",
  "description": "Backend API service for SuiTwo Shooter Game - Game-specific endpoints",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "dev:clean": "node -e \"try{require('node:fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\" && next dev -p 3001",
    "postinstall": "patch-package",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@mysten/bcs": "^1.9.2",
    "@mysten/sui": "^1.44.0",
    "@vercel/kv": "^3.0.0",
    "bech32": "^2.0.0",
    "next": "^15.1.0",
    "patch-package": "^8.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
